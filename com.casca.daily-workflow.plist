<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.casca.daily-workflow</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/victoryves/casca-automation-blog-runner/scripts/run-daily-wrapper.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/victoryves/casca-automation-blog-runner</string>

    <!-- Check every 15 minutes so queued rejections are processed promptly -->
    <key>StartInterval</key>
    <integer>900</integer>

    <!-- Run on load too (catches missed runs after sleep/reboot) -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <false/>

    <!-- Allow enough time for retries, scraping, and synthesis -->
    <key>TimeOut</key>
    <integer>3600</integer>

    <key>StandardOutPath</key>
    <string>/Users/victoryves/casca-automation-blog-runner/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/victoryves/casca-automation-blog-runner/logs/launchd-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/victoryves</string>
        <key>APP_TIMEZONE</key>
        <string>America/Toronto</string>
    </dict>
</dict>
</plist>
