<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unique identifier for this agent -->
    <key>Label</key>
    <string>com.casca.daily-workflow</string>

    <!-- Program to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/vicyves1/Documents/personal/Vibe Coding/casca-automation-blog/scripts/run-daily-wrapper.sh</string>
    </array>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/Users/vicyves1/Documents/personal/Vibe Coding/casca-automation-blog</string>

    <!-- Run at midnight (00:00) every day -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Keep the agent loaded -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Restart if it crashes -->
    <key>KeepAlive</key>
    <false/>

    <!-- Standard output and error logging -->
    <key>StandardOutPath</key>
    <string>/Users/vicyves1/Documents/personal/Vibe Coding/casca-automation-blog/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/vicyves1/Documents/personal/Vibe Coding/casca-automation-blog/logs/launchd-stderr.log</string>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
